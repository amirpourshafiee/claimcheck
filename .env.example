# Copy this file to .env and fill it in. Never commit .env.
# Get a key from the Anthropic Console (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Hard cap on paid API calls per run. The pipeline refuses to exceed it.
CLAIMCHECK_MAX_CALLS=200

# Judge model name. Check the official model list before setting this; do not guess.
CLAIMCHECK_JUDGE_MODEL=
